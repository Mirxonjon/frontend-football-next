# ─── Frontend host / port ────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3001

# ─── Backend API ────────────────────────────────────────────────────
# Dev default: http://localhost:4021/v1/
# Production:  https://api.coachingzona.uz/v1/
NEXT_PUBLIC_API_BASE_URL=http://localhost:4021/v1/

# ─── CORS — backend env ham shu qiymatga ega bo'lsin ───────────────
NEXT_PUBLIC_CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ─── Google OAuth ───────────────────────────────────────────────────
# Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
# "Authorized JavaScript origins" ga http://localhost:3001 qo'shilgan bo'lishi shart.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── YouTube API (ixtiyoriy) ────────────────────────────────────────
NEXT_PUBLIC_YT_API_KEY=
