# Copy to `.env` next to docker-compose.yml and adjust values per host.
#
# `APP_PORT` is the ONLY thing you usually need to change per server, to
# avoid clashing with already-bound ports.

# ─── Host port (the one that might be busy) ────────────────────────────
APP_PORT=3001

# ─── NEXT_PUBLIC_* — baked into the client bundle at BUILD time ────────
NEXT_PUBLIC_APP_ORIGIN=https://coaching-center.uz
NEXT_PUBLIC_API_BASE_URL=https://api.coaching-center.uz/v1/
NEXT_PUBLIC_CORS_ORIGINS=https://coaching-center.uz
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_YT_API_KEY=
